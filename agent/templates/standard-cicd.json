{"name":"standard-cicd","dag":{"steps":[{"id":"plan","task":{"instruction":"Analyze the issue, read the codebase, create an implementation plan","image":"stronghold/rust-nightly","ttl_secs":1800},"depends_on":[],"role":"planner"},{"id":"implement","task":{"instruction":"Implement the fix. Create branch, write code, run tests, push, create PR.","image":"stronghold/rust-nightly","ttl_secs":7200},"depends_on":["plan"],"role":"coder"},{"id":"test","task":{"instruction":"Run full test suite. Report results.","image":"stronghold/rust-nightly","ttl_secs":1800},"depends_on":["implement"],"role":"tester","condition":"implement.result.exit_code == 0"},{"id":"review","task":{"instruction":"Review the PR. Approve or request changes.","image":"stronghold/rust-nightly","ttl_secs":1800},"depends_on":["test"],"role":"reviewer","condition":"test.result.failed == 0"},{"id":"merge","task":{"instruction":"Merge the approved PR. Run CI on main.","image":"stronghold/rust-nightly","ttl_secs":1800},"depends_on":["review"],"role":"integrator","condition":"review.result.approved == true"}]}}
